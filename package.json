{
  "name": "keja-ai",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build --webpack && node scripts/inject-preloads.mjs && bun scripts/generate-sitemap.mjs && bun scripts/prerender.ts && node scripts/sw-version.mjs && node scripts/verify-artifacts.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "sitemap": "bun scripts/generate-sitemap.mjs",
    "prerender": "bun scripts/prerender.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "description": "Keja AI — Africa's Real Estate Intelligence & Trust Infrastructure. Discover. Verify. Analyse. Finance. Invest. Transact. Manage. A Chacadom Investments venture.",
  "author": "Chacadom Investments",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "defu": "^6.1.7",
    "postcss": "^8.5.28",
    "nanoid": "~3.3.18",
    "baseline-browser-mapping": "^2.11.22"
  }
}

# Netlify header rules — ships inside out/ because API (zip) deploys do not
# read netlify.toml from the repo. Mirrors the [[headers]] blocks there.
#
# The service worker must never be cached by the CDN/edge, or updates take
# up to a day to reach installed clients.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/icons/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/screenshots/*
  Cache-Control: public, max-age=604800

/splash/*
  Cache-Control: public, max-age=604800

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

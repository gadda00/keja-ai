{
  "id": "/",
  "name": "Keja AI — Africa's Real Estate Intelligence & Trust Infrastructure",
  "short_name": "Keja AI",
  "description": "Discover. Verify. Analyse. Finance. Invest. Transact. Manage. Kenya's AI real-estate ecosystem for every stakeholder.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#F7F5EF",
  "theme_color": "#0E7A4E",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "house", "finance", "productivity"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "./screenshots/narrow.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Verified property search with AI trust scores"
    },
    {
      "src": "./screenshots/wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The full ecosystem — discover, verify, analyse, finance, invest"
    }
  ],
  "shortcuts": [
    {
      "name": "Search properties",
      "short_name": "Properties",
      "url": "./#/properties",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ask Keja AI",
      "short_name": "Ask Keja",
      "url": "./#/ask",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Deal Analyst",
      "short_name": "Analyse",
      "url": "./#/deal-analyst",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}

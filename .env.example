# Keja.ai build-time environment (all values are PUBLIC — this app is a static
# SPA, so nothing here is a secret; secrets belong to the Phase-2 backend).
#
# Copy to .env.local and adjust. Every variable is optional — the defaults
# target the current GitHub Pages deployment.

# Canonical origin for SEO tags, JSON-LD, sitemap and robots.
# Override when a custom domain goes live (e.g. https://keja.ai).
VITE_SITE_URL=https://gadda00.github.io

# Public WhatsApp contact (digits only, international format, no +).
VITE_WHATSAPP=254700123456

# Keja AI — environment reference (.env.example)
# --------------------------------------------------------------------------
# This file documents every environment variable the app understands.
# Copy to `.env.local` for local development. In production the values live
# in Vercel: Project Settings → Environment Variables (all are build-time
# inlined NEXT_PUBLIC_* — safe for the static export).
#
# NOTE: never commit real secrets. Demo/QA values only.

# --- Site ---------------------------------------------------------------
# Canonical origin (SEO, sitemap, og:image URLs). Defaults to https://keja.app
NEXT_PUBLIC_SITE_URL=https://keja.app

# WhatsApp support number (international format, digits only)
NEXT_PUBLIC_WHATSAPP=254108611387

# Optional sub-path when the build is served from a sub-directory
# (the keja.app root deploy leaves this empty)
NEXT_PUBLIC_BASE_PATH=

# --- Google Sign-In (Google Identity Services) ---------------------------
# Real Google accounts activate when this is set. Create the OAuth client in
# Google Cloud Console (APIs & Services → Credentials → OAuth client ID,
# type "Web application", authorised origin https://keja.app), then set the
# value here / in Vercel and redeploy. Full runbook: docs/GOOGLE_AUTH_SETUP.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Comma-separated allowlist of Google emails that get the ADMIN role on
# sign-in (case-insensitive; upgrades only, never downgrades):
NEXT_PUBLIC_ADMIN_EMAILS=clive@chacadom.com

# --- CI / Vercel (repo secrets, not app runtime) --------------------------
# VERCEL_TOKEN   — used by the "Deploy to Vercel (keja.app)" workflow
# VERCEL_ORG_ID  — baked into .github/workflows/deploy-vercel.yml
# VERCEL_PROJECT_ID — baked into .github/workflows/deploy-vercel.yml

# Keja AI — environment example (copy to .env for local overrides).
# All values are optional; the static build works with none of them set.
# NEXT_PUBLIC_* variables are inlined at build time (safe for static export).

# Canonical origin (SEO, deep links, sitemap). Default: https://keja.app
# NEXT_PUBLIC_SITE_URL=https://keja.app

# WhatsApp business number (digits only, international format).
# NEXT_PUBLIC_WHATSAPP=254108611387

# --- Telemetry (audit F-10 / F-11) -----------------------------------------
# Sentry project DSN — when set, production errors are reported with the
# build release tag. Create a project at https://sentry.io and paste the DSN.
# NEXT_PUBLIC_SENTRY_DSN=

# Cookieless analytics collector that accepts POST JSON
# {name, data, ts, session, release}. No-op when unset.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# --- Future Phase-2 API seam (audit Ch. 24) ----------------------------------
# Base URL of the auth/tenant API. When set, the store twins switch from
# local-only persistence to the remote service.
# NEXT_PUBLIC_API_URL=

# --- Native / tooling --------------------------------------------------------
# Base path when serving the export from a subdirectory (e.g. GitHub Pages).
# NEXT_PUBLIC_BASE_PATH=

# Prisma (schema tooling only until the API seam ships)
# DATABASE_URL="file:./db/custom.db"
